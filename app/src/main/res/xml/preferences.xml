<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="@string/settings_apps_hidden_key"
        android:title="@string/settings_apps_hidden" />

    <SwitchPreference
        android:key="@string/settings_display_rotate_screen_key"
        android:defaultValue="true"
        android:title="@string/settings_display_rotate_screen" />

    <Preference
        android:key="settings_meta_licenses"
        android:title="@string/settings_meta_licenses" />

    <Preference
        android:key="settings_meta_version"
        android:title="@string/settings_meta_version" />

    <Preference
        android:key="@string/settings_mdm_server_url_key"
        android:title="@string/settings_mdm_server_url" />

    <Preference
        android:key="@string/settings_mdm_tailscale_auth_key_key"
        android:title="@string/settings_mdm_tailscale_auth_key" />

    <Preference
        android:key="settings_mdm_enroll_now"
        android:title="@string/settings_mdm_enroll_now" />

    <Preference
        android:key="settings_mdm_sync_now"
        android:title="@string/settings_mdm_sync_now" />

    <SwitchPreference
        android:key="@string/settings_mdm_restrictions_paused_key"
        android:defaultValue="false"
        android:title="@string/settings_mdm_restrictions_paused"
        android:summary="@string/settings_mdm_restrictions_paused_summary" />

</PreferenceScreen>
